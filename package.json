{
  "name": "price-board-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm:server\" \"npm:web\"",
    "server": "tsx server/index.ts",
    "web": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "4.8.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "description": "Bảng giá chứng khoán realtime chạy với mock server: đặt lệnh, sổ lệnh, đăng nhập giả lập, biểu đồ nến."
}
